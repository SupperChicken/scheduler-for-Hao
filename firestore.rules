rules_version = '2';
// Luật bảo mật cho Phân Ca Sân Bay.
// 1) Sửa email ở dòng OWNERS thành email Google của bạn (chủ dự án). Có thể ghi nhiều email: ['a@gmail.com', 'b@gmail.com']
// 2) Dán toàn bộ file này vào Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function OWNERS() { return ['nguyenvanthien3290@gmail.com']; }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function hasMembers() { return exists(/databases/$(database)/documents/access/members); }
    function members() { return get(/databases/$(database)/documents/access/members).data; }
    function isOwner() { return signedIn() && myEmail() in OWNERS(); }
    function isEditor() { return isOwner() || (signedIn() && hasMembers() && myEmail() in members().editors); }
    function isViewer() { return isEditor() || (signedIn() && hasMembers() && myEmail() in members().viewers); }

    // danh sách người được xem / được sửa
    match /access/members {
      allow read: if isViewer();
      allow write: if isEditor()
        && request.resource.data.editors is list
        && request.resource.data.viewers is list;
    }
    // cài đặt chung + mục lục các tuần
    match /config/{docId} {
      allow read: if isViewer();
      allow write: if isEditor();
    }
    // lịch từng tuần
    match /weeks/{weekId} {
      allow read: if isViewer();
      allow write: if isEditor();
    }
    // ai đang mở trang (chỉ người làm lịch thấy)
    match /presence/{uid} {
      allow read: if isEditor();
      allow write: if isEditor() && request.auth.uid == uid;
    }
    // mọi thứ khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
